<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_container"
    tools:context="com.genesys.codebase.MainActivity">
    <View
        android:id="@+id/topline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topline" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.genesys.shape.layout.ShapeFrameLayout
            android:id="@+id/layout_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_effect1Blur="0dp"
            app:shape_effect1Color="@color/color_neo_border"
            app:shape_effect1OffsetX="4dp"
            app:shape_effect1OffsetY="4dp"
            app:shape_effect1Type="dropShadow"
            app:shape_radius="20dp"
            app:shape_solidColor="@color/color_bg_container"
            app:shape_strokeColor="@color/color_neo_border"
            app:shape_strokeSize="2dp">

            <com.genesys.core.ui.custom.CustomBottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.genesys.shape.layout.ShapeFrameLayout>

        <com.genesys.shape.view.ShapeImageView
            android:id="@+id/btn_center_action"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/nav_primary"
            android:scaleType="centerInside"
            app:layout_constraintEnd_toEndOf="@id/layout_bottom_bar"
            app:layout_constraintStart_toStartOf="@id/layout_bottom_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_effect1Blur="0dp"
            app:shape_effect1Color="@color/color_neo_border"
            app:shape_effect1OffsetX="4dp"
            app:shape_effect1OffsetY="4dp"
            app:shape_effect1Type="dropShadow"
            app:shape_solidColor="@color/color_neo_action_button_bg"
            app:shape_strokeColor="@color/color_neo_border"
            app:shape_strokeSize="2.5dp"
            app:shape_type="oval"
            app:srcCompat="@drawable/ic_nav_primary"
            app:tint="@color/color_neo_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>